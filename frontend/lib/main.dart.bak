      alignment: Alignment.centerLeft,
      filterQuality: FilterQuality.high,
      errorBuilder: (context, error, stackTrace) {
        return const Text(
          'UniGuide AI',
          style: TextStyle(
            fontSize: 18,
            fontWeight: FontWeight.w800,
            color: AppColors.textPrimary,
          ),
        );
      },
    );
  }
}
