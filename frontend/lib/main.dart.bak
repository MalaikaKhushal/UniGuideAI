class _OfficialReference extends StatefulWidget {
  final String source;

  const _OfficialReference({required this.source});

  @override
  State<_OfficialReference> createState() => _OfficialReferenceState();
}

class _OfficialReferenceState extends State<_OfficialReference> {
  bool hovering = false;

  String get sourceName {
    final value = widget.source.toLowerCase();

    if (value.contains('fee')) {
      return 'CUI Fee Structure';
    }

    if (value.contains('admission')) {
      return 'CUI Admissions';
    }

    if (value.contains('scholar')) {
      return 'CUI Scholarships';
    }

    if (value.contains('hostel')) {
      return 'CUI Hostel';
    }

    if (value.contains('transport')) {
      return 'CUI Transport';
    }

    if (value.contains('student_affairs')) {
      return 'CUI Student Affairs';
    }

    if (value.contains('rules') || value.contains('conduct')) {
      return 'CUI Code of Conduct';
    }

    if (value.contains('contact')) {
      return 'CUI Contact';
    }

    if (value.contains('program')) {
      return 'CUI Undergraduate Programs';
    }

    if (value.contains('faq')) {
      return 'CUI FAQs';
    }

    if (value.contains('general')) {
      return 'CUI Abbottabad';
    }

    return 'CUI Abbottabad';
  }

  String get description {
    final value = widget.source.toLowerCase();

    if (value.contains('fee')) {
      return 'Official fee structure';
    }

    if (value.contains('admission')) {
      return 'Official admissions information';
    }

    if (value.contains('scholar')) {
      return 'Official scholarship information';
    }

    if (value.contains('hostel')) {
      return 'Official hostel information';
    }

    if (value.contains('transport')) {
      return 'Official transport information';
    }

    if (value.contains('student_affairs')) {
      return 'Official student affairs information';
    }

    if (value.contains('rules') || value.contains('conduct')) {
      return 'Official university rules';
    }

    if (value.contains('contact')) {
      return 'Official campus contact information';
    }

    if (value.contains('program')) {
      return 'Official degree programs';
    }

    if (value.contains('faq')) {
      return 'Official frequently asked questions';
    }

    return 'Official CUI Abbottabad source';
  }

  String get url {
    final value = widget.source.toLowerCase();

    if (value.contains('fee')) {
      return 'https://www.cuiatd.edu.pk/admissions-overview/fee-structure/';
    }

    if (value.contains('admission')) {
      return 'https://www.cuiatd.edu.pk/admissions/';
    }

    if (value.contains('scholar')) {
      return 'https://www.cuiatd.edu.pk/admissions/scholarships/';
    }

    if (value.contains('hostel')) {
      return 'https://www.cuiatd.edu.pk/students/hostel/';
    }

    if (value.contains('transport')) {
      return 'https://www.cuiatd.edu.pk/students/transport-2/';
    }

    if (value.contains('student_affairs')) {
      return 'https://www.cuiatd.edu.pk/about/offices-and-administration/student-affairs/';
    }

    if (value.contains('rules') || value.contains('conduct')) {
      return 'https://www.cuiatd.edu.pk/students/code-of-conduct/';
    }

    if (value.contains('contact')) {
      return 'https://cuiatd.edu.pk/contact-us/';
    }

    if (value.contains('program')) {
      return 'https://www.cuiatd.edu.pk/admissions-overview/undergraduate/';
    }

    if (value.contains('faq')) {
      return 'https://cuiatd.edu.pk/faqs/';
    }

    return 'https://cuiatd.edu.pk/';
  }

  Future<void> openReference() async {
    final uri = Uri.parse(url);

    await launchUrl(uri, mode: LaunchMode.externalApplication);
  }

  @override
  Widget build(BuildContext context) {
    return MouseRegion(
      cursor: SystemMouseCursors.click,
      onEnter: (_) {
        setState(() {
          hovering = true;
        });
      },
      onExit: (_) {
        setState(() {
          hovering = false;
        });
      },
      child: GestureDetector(
        onTap: openReference,
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 180),
          curve: Curves.easeOut,
          transform: Matrix4.translationValues(0, hovering ? -2 : 0, 0),
          padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
          decoration: BoxDecoration(
            color: hovering ? const Color(0xFFF4F8FC) : Colors.white,
            borderRadius: BorderRadius.circular(11),
            border: Border.all(
              color: hovering
                  ? const Color(0xFFBDD5E8)
                  : const Color(0xFFE3E9EF),
            ),
          ),
          child: Row(
            children: [
              // --------------------------------------------------
              // CUI mini brand mark
              // --------------------------------------------------
              Container(
                width: 32,
                height: 32,
                decoration: BoxDecoration(
                  color: const Color(0xFFF0F5FA),
                  borderRadius: BorderRadius.circular(8),
                  border: Border.all(color: const Color(0xFFDCE6EF)),
                ),
                child: const Center(
                  child: Text(
                    'CUI',
                    style: TextStyle(
                      fontSize: 9,
                      fontWeight: FontWeight.w900,
                      color: AppColors.navy,
                    ),
                  ),
                ),
              ),

              const SizedBox(width: 9),

              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      sourceName,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        fontSize: 11.5,
                        fontWeight: FontWeight.w700,
                        color: AppColors.textPrimary,
                      ),
                    ),
                    const SizedBox(height: 2),
                    Text(
                      description,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        fontSize: 10,
                        color: AppColors.textSecondary,
                      ),
                    ),
                  ],
                ),
              ),

              const SizedBox(width: 7),

              AnimatedRotation(
                turns: hovering ? 0.04 : 0,
                duration: const Duration(milliseconds: 180),
                child: Icon(
                  Icons.open_in_new_rounded,
                  size: 15,
                  color: hovering ? AppColors.blue : AppColors.textSecondary,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

